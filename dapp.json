{
  "name": "Omichat",
  "description": "Meet people nearby who share your interests, for friends and hobbies.",
  "icon": {
    "emoji": "💬"
  },
  "secrets": [
    {
      "key": "SMTP_URL",
      "description": "SMTP connection for verification codes, e.g. smtp://user:pass@host:port. Leave unset to disable email verification in production (staging previews show the code inline instead).",
      "required": false,
      "private": true
    },
    {
      "key": "SMTP_FROM",
      "description": "From address for verification emails, e.g. \"Omichat <no-reply@yourdomain.com>\".",
      "required": false,
      "private": true
    }
  ],
  "tests": [
    {
      "id": "discover.card",
      "name": "Discover renders the profile card",
      "path": "/",
      "expectSelector": "[data-testid=\"profile-card\"]",
      "expectText": "Discover",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "id": "discover.presence",
      "name": "Discover card shows the online status",
      "path": "/",
      "expectText": "Online"
    },
    {
      "id": "hellos.empty",
      "name": "Hellos tab shows its empty state",
      "path": "/#hellos",
      "expectText": "No hellos yet"
    },
    {
      "id": "profile.verification",
      "name": "Profile shows the verification card",
      "path": "/#profile",
      "expectText": "Get verified",
      "visual": true,
      "impact": [
        "public/**",
        "server.js",
        "dapp.json"
      ]
    },
    {
      "id": "messages.color-coded",
      "name": "Messages list renders colour-coded threads",
      "path": "/#messages",
      "expectSelector": "[data-testid=\"thread-row\"]",
      "expectText": "Messages",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "id": "discover.filters",
      "name": "Discover shows the age and distance filters control",
      "path": "/",
      "expectSelector": "[data-testid=\"filters-button\"]",
      "expectText": "Filters",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "id": "discover.full-profile",
      "name": "Full profile opens with Skip and Say hi",
      "path": "/#discover/1",
      "expectSelector": "[data-testid=\"full-profile\"] [data-testid=\"profile-prompts\"]",
      "expectText": "Say hi",
      "visual": true,
      "impact": [
        "public/**"
      ]
    },
    {
      "id": "discover.shared-interests",
      "name": "Discover card shows the interests-in-common line",
      "path": "/",
      "expectSelector": "[data-testid=\"profile-card\"] [data-testid=\"shared-interests\"]"
    },
    {
      "id": "profile.completeness",
      "name": "Profile tab shows the completeness meter",
      "path": "/#profile",
      "expectSelector": "[data-testid=\"profile-completeness\"]",
      "expectText": "complete"
    },
    {
      "id": "profile.edit",
      "name": "Edit Profile loads the saved profile",
      "path": "/#profile/edit",
      "expectSelector": "[data-testid=\"edit-interests\"]",
      "expectText": "Save changes",
      "visual": true,
      "impact": [
        "public/**",
        "server.js"
      ]
    }
  ]
}
