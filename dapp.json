{
  "name": "Omichat",
  "description": "Swipe, like and chat with people nearby. Phase 1: the Discover deck.",
  "icon": { "emoji": "💬" },
  "permissions": [
    { "capability": "camera", "reason": "Takes your selfie for profile verification" }
  ],
  "secrets": [
    {
      "key": "SMTP_URL",
      "description": "SMTP connection for verification codes, e.g. smtp://user:pass@host:port. Leave unset to disable email verification in production (staging previews show the code inline instead).",
      "required": false,
      "private": true
    },
    {
      "key": "SMTP_FROM",
      "description": "From address for verification emails, e.g. \"Omichat <no-reply@yourdomain.com>\".",
      "required": false,
      "private": true
    }
  ],
  "tests": [
    {
      "id": "discover.card",
      "name": "Discover renders the profile card",
      "path": "/",
      "expectSelector": "[data-testid=\"profile-card\"]",
      "expectText": "Discover",
      "visual": true,
      "impact": ["public/**"]
    },
    {
      "id": "discover.presence",
      "name": "Discover card shows the online status",
      "path": "/",
      "expectText": "Online"
    },
    {
      "id": "likes.empty",
      "name": "Likes tab shows its empty state",
      "path": "/#likes",
      "expectText": "No likes yet"
    },
    {
      "id": "profile.verification",
      "name": "Profile shows the verification card",
      "path": "/#profile",
      "expectText": "Get verified",
      "visual": true,
      "impact": ["public/**", "server.js", "dapp.json"]
    },
    {
      "id": "messages.color-coded",
      "name": "Messages list renders colour-coded threads",
      "path": "/#messages",
      "expectSelector": "[data-testid=\"thread-row\"]",
      "expectText": "Messages",
      "visual": true,
      "impact": ["public/**"]
    },
    {
      "id": "discover.filters",
      "name": "Discover shows the age and distance filters control",
      "path": "/",
      "expectSelector": "[data-testid=\"filters-button\"]",
      "expectText": "Filters",
      "visual": true,
      "impact": ["public/**"]
    },
    {
      "id": "safety.card-menu",
      "name": "Profile card has the three-dot menu",
      "path": "/",
      "expectSelector": "[data-testid=\"profile-card\"] [data-card-menu]",
      "visual": true,
      "impact": ["public/**"]
    },
    {
      "id": "safety.age-gate",
      "name": "Sign-up shows the 18+ age gate",
      "path": "/",
      "expectSelector": "[data-testid=\"age-gate\"]",
      "expectText": "Confirm your age",
      "visual": true,
      "impact": ["public/**"]
    },
    {
      "id": "safety.privacy-row",
      "name": "Profile lists Privacy and Selfie verification",
      "path": "/#profile",
      "expectSelector": "[data-testid=\"selfie-row\"]",
      "expectText": "Privacy and safety"
    }
  ]
}
